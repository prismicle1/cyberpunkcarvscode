-- Peripheral linking and controller setup
local controller = peripheral.find("tweaked_controller")
if not controller then
    print("Tweaked Controller not found!")
    return
end

controller.setFullPrecision(true)

-- Throttle state
local power = 15        -- Start at full resistor power (engine off)
local MIN_POWER = 0     -- Full speed
local MAX_POWER = 15    -- Engine off
local COAST_SPEED = 0.01
local BRAKE_SPEED = 0.2
local ACCEL_SPEED = 0.05

-- Output to redstone resistor (assumes below computer)
local RESISTOR_SIDE = "bottom"

-- Time tracking
local function sleepTick()
    os.sleep(0.05)
end

-- Main loop
while true do
    if controller.hasUser() then
        local yAxis = -controller.getAxis(2) -- Inverted: Up (W) = 1, Down (S) = -1

        if yAxis > 0.2 then
            -- Holding W (Accelerate)
            power = math.max(MIN_POWER, power - ACCEL_SPEED)
        elseif yAxis < -0.2 then
            -- Holding S (Brake/Reverse)
            power = math.min(MAX_POWER, power + BRAKE_SPEED)
        else
            -- Neither: slowly return to default (coast)
            power = math.min(MAX_POWER, power + COAST_SPEED)
        end

        rs.setAnalogOutput(RESISTOR_SIDE, math.floor(power + 0.5))
    end

    sleepTick()
end
